# Copia este archivo como .env y rellénalo (el .env NO se sube a GitHub)
PORT=3000

# Clave para firmar los JWT: pon una cadena larga y aleatoria
SECRET_KEY=

# Firebase: el contenido del JSON de la cuenta de servicio en una sola línea...
FIREBASE_SERVICE_ACCOUNT=
# ...o, en local, la ruta al archivo JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Supabase Storage (imágenes y documentos subidos)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=palacio-ferias

# URL del frontend (CORS e imágenes de los stands). Varias separadas por comas.
FRONTEND_URL=https://tu-proyecto.vercel.app

# Solo para `npm run seed`
SEED_ADMIN_NAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
